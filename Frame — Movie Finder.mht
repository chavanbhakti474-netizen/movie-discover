.film-genre { color: rgb(189, 154, 109); }

.meta-divider { width: 2px; height: 2px; border-radius: 50%; background: rgb(100, 103, 102); }

.film-rating, .film-runtime { display: inline-flex; align-items: center; gap: 4px; }

.film-rating { color: rgb(210, 179, 131); }

.film-runtime { margin-left: auto; color: rgb(131, 134, 133); }

