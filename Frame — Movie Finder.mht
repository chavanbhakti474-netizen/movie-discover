.details-toggle { display: inline-flex; align-items: center; gap: 7px; padding: 7px 0px 0px; border-width: 1px 0px 0px; border-style: solid none none; border-color: rgba(231, 228, 219, 0.1) currentcolor currentcolor; border-image: none; width: 100%; background: transparent; color: rgb(161, 161, 154); font-size: 9px; text-align: left; cursor: pointer; transition: color 0.18s; }

.details-toggle svg { color: var(--amber); }

.details-toggle:hover { color: var(--amber); }

.film-details { display: grid; grid-template-columns: auto 1fr; gap: 8px 12px; border-left: 1px solid rgba(219, 173, 112, 0.46); margin: 0px 0px 12px; padding: 2px 0px 2px 10px; animation: 0.2s ease 0s 1 normal both running card-in; }

.film-details span { color: rgb(121, 125, 124); font-size: 7px; align-self: center; }

.film-details strong { color: rgb(210, 207, 198); font-size: 9px; font-weight: 500; }

.empty-state { padding: 62px 24px 75px; text-align: center; border: 1px dashed rgba(231, 228, 219, 0.17); background: rgba(29, 31, 34, 0.4); }

.empty-icon { width: 52px; height: 52px; display: grid; place-items: center; margin: 0px auto 19px; border: 1px solid rgba(219, 173, 112, 0.3); border-radius: 50%; color: var(--amber); }

.empty-state .eyebrow { color: rgb(156, 138, 109); }

