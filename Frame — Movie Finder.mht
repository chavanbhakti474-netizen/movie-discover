@layer base {
  * { border-color: hsl(var(--border)); }
  body { background-color: hsl(var(--background)); font-family: var(--app-font-sans); color: hsl(var(--foreground)); -webkit-font-smoothing: antialiased; margin: 0px; min-width: 320px; }
}

:root { color-scheme: dark; --ink: #e9e5dc; --dim: #9a9a98; --quiet: #707477; --line: rgba(231, 228, 219, .12); --amber: #dbad70; --night: #17191c; --panel: #1d1f22; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { background: rgb(23, 25, 28); }

button, input, select { font: inherit; }

button { color: inherit; }

button:focus-visible, input:focus-visible, select:focus-visible, a:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; }

.site-shell { width: min(100%, 1440px); margin: 0px auto; overflow: hidden; background: radial-gradient(at 83% 6%, rgba(115, 95, 75, 0.086), transparent 30%), rgb(23, 25, 28); min-height: 100dvh; }

.topbar { height: 76px; display: flex; align-items: center; justify-content: space-between; margin: 0px 7.15%; border-bottom: 1px solid var(--line); }

.brand, .footer-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 21px; font-weight: 600; letter-spacing: -0.07em; }

.brand-mark { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid rgba(219, 173, 112, 0.56); border-radius: 50%; color: var(--amber); }

.brand-period, .footer-brand span { color: var(--amber); }

.header-note { display: flex; align-items: center; gap: 10px; color: rgb(170, 169, 164); font-size: 12px; letter-spacing: 0.025em; }

.live-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--amber); box-shadow: rgba(219, 173, 112, 0.09) 0px 0px 0px 4px; }

.topbar-right { display: flex; align-items: center; gap: 12px; }

.topbar-label, .pick-label, .eyebrow, .results-bar p, .results-bar-note, .year-select-wrap > span, .film-details span, .pick-meta, .footer-count { font-family: var(--app-font-mono); letter-spacing: 0.12em; }

.topbar-label { font-size: 9px; color: rgb(119, 123, 123); }

.topbar-rule { width: 32px; height: 1px; background: var(--amber); opacity: 0.72; }

.hero { position: relative; min-height: 430px; padding: 85px 7.15% 77px; display: flex; align-items: center; border-bottom: 1px solid var(--line); }

.hero::after { content: ""; position: absolute; left: 7.15%; right: 7.15%; bottom: 0px; height: 1px; background: linear-gradient(90deg, transparent, rgba(219, 173, 112, 0.42), transparent); opacity: 0.48; }

.hero-copy { position: relative; z-index: 1; max-width: 620px; }

.eyebrow { margin: 0px; color: var(--amber); font-size: 9px; font-weight: 400; line-height: 1.5; }

.hero .eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }

.eyebrow-line { width: 29px; height: 1px; background: var(--amber); }

.hero h1 { margin: 0px; font-family: var(--app-font-serif); font-size: clamp(54px, 6.4vw, 88px); font-weight: 500; line-height: 0.99; letter-spacing: -0.055em; color: rgb(233, 229, 220); }

.hero h1 em { color: var(--amber); font-weight: 500; }

.hero-subtitle { margin: 24px 0px 0px 2px; font-size: 13px; color: rgb(153, 154, 153); letter-spacing: 0.01em; line-height: 1.7; }

.hero-pick { display: flex; align-items: flex-end; gap: 19px; position: absolute; right: 13.7%; bottom: 73px; width: 275px; z-index: 1; }

.hero-pick-art { width: 91px; height: 130px; flex: 0 0 91px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.28) 0px 16px 30px; transform: rotate(-3deg); }

.hero-pick-copy { display: flex; flex-direction: column; padding-bottom: 3px; }

.pick-label { display: flex; align-items: center; gap: 7px; font-size: 8px; color: var(--amber); margin-bottom: 11px; }

.hero-pick-copy strong { font-family: var(--app-font-serif); font-size: 20px; font-weight: 500; line-height: 1.1; color: rgb(230, 225, 215); }

.pick-meta { font-size: 7px; color: rgb(133, 135, 135); margin-top: 12px; white-space: nowrap; }

.pick-meta i { color: var(--amber); font-style: normal; margin: 0px 3px; }

.pick-index { position: absolute; top: -26px; left: 111px; color: rgb(103, 107, 109); font: 8px var(--app-font-mono); letter-spacing: 0.08em; }

.hero-stamp { position: absolute; right: 7.8%; top: 56px; width: 88px; height: 88px; border: 1px solid rgba(219, 173, 112, 0.34); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: rgb(152, 146, 135); font: 6px/1.45 var(--app-font-mono); letter-spacing: 0.2em; transform: rotate(13deg); }

.hero-stamp b { position: absolute; font: 24px var(--app-font-serif); color: rgba(219, 173, 112, 0.3); letter-spacing: 0px; transform: rotate(-13deg); }

.discovery { padding: 71px 7.15% 83px; }

.section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 31px; }

.section-eyebrow { color: rgb(136, 137, 135); margin-bottom: 10px; }

.section-heading h2 { margin: 0px; font: 500 clamp(28px, 3vw, 38px)/1.15 var(--app-font-serif); letter-spacing: -0.04em; }

.section-heading h2 span { color: var(--amber); }

.collection-note { color: rgb(137, 139, 138); font-size: 11px; line-height: 1.75; margin: 0px 0px 2px; text-align: right; }

.search-row { display: flex; gap: 12px; }

.search-box { display: flex; align-items: center; height: 49px; flex: 1 1 0%; min-width: 0px; padding: 0px 16px; gap: 13px; border: 1px solid rgba(229, 226, 218, 0.15); background: rgba(28, 30, 33, 0.82); color: rgb(151, 154, 155); transition: border-color 0.2s, background 0.2s; }

.search-box:focus-within { border-color: rgba(219, 173, 112, 0.6); background: rgb(32, 34, 37); }

.search-box input { min-width: 0px; flex: 1 1 0%; color: var(--ink); border: 0px; background: transparent; outline: none; font-size: 12px; }

.search-box input::placeholder { color: rgb(121, 125, 126); }

.search-box kbd { font: 9px var(--app-font-mono); color: rgb(104, 108, 109); border: 1px solid rgb(55, 58, 61); padding: 4px 6px; border-radius: 3px; white-space: nowrap; }

.clear-search { cursor: pointer; background: none; border: 0px; color: rgb(159, 160, 157); padding: 5px; display: grid; place-items: center; }

.sort-wrap { position: relative; flex: 0 0 178px; }

.sort-button { display: flex; height: 49px; align-items: center; justify-content: space-between; width: 100%; padding: 0px 14px; border: 1px solid rgba(229, 226, 218, 0.15); background: rgb(28, 30, 33); color: rgb(196, 193, 185); font-size: 11px; cursor: pointer; transition: border-color 0.2s, color 0.2s; }

.sort-button:hover, .sort-button.sort-active { border-color: rgba(219, 173, 112, 0.55); color: var(--amber); }

.sort-button > span { flex: 1 1 0%; text-align: left; margin-left: 9px; }

.sort-menu { z-index: 5; position: absolute; top: calc(100% + 5px); right: 0px; width: 100%; background: rgb(37, 39, 42); border: 1px solid rgb(57, 59, 62); box-shadow: rgba(0, 0, 0, 0.4) 0px 12px 30px; padding: 5px; }

.sort-menu button { display: flex; justify-content: space-between; width: 100%; padding: 10px; border: 0px; background: transparent; color: rgb(195, 193, 186); text-align: left; font-size: 11px; cursor: pointer; }

.sort-menu button:hover { background: rgb(48, 50, 53); color: var(--amber); }

.filter-row { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 18px 0px 22px; border-bottom: 1px solid var(--line); }

.genre-pills { display: flex; flex-wrap: wrap; gap: 7px; }

.genre-pill { cursor: pointer; border: 1px solid transparent; background: transparent; color: rgb(154, 156, 154); font-size: 10px; padding: 8px 12px; transition: color 0.18s, border-color 0.18s, background 0.18s; }

.genre-pill:hover { color: var(--ink); border-color: rgba(232, 228, 219, 0.16); }

.genre-pill.selected { color: var(--amber); border-color: rgba(219, 173, 112, 0.42); background: rgba(219, 173, 112, 0.07); }

.year-select-wrap { position: relative; display: flex; align-items: center; gap: 10px; color: rgb(121, 124, 124); flex: 0 0 auto; }

.year-select-wrap > span { font-size: 8px; }

.year-select-wrap select { appearance: none; cursor: pointer; background: transparent; color: rgb(178, 176, 170); border: 0px; font-size: 10px; padding: 7px 18px 7px 0px; outline: none; }

.year-select-wrap select option { background: rgb(32, 34, 37); }

.year-select-wrap svg { pointer-events: none; position: absolute; right: 0px; color: rgb(146, 148, 146); }

.results-bar { display: flex; align-items: center; justify-content: space-between; padding: 23px 0px 17px; }

.results-bar p { margin: 0px; color: rgb(137, 140, 139); font-size: 8px; }

.results-bar p span { color: var(--amber); margin-right: 8px; font-size: 11px; }

.results-bar-note { font-size: 8px; color: rgb(98, 102, 103); }

.film-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 32px 25px; }

.film-card { min-width: 0px; background: rgba(30, 32, 35, 0.68); border: 1px solid rgba(231, 228, 219, 0.106); animation: 0.45s ease 0s 1 normal both running card-in; transition: border-color 0.22s, transform 0.22s, background 0.22s; }

.film-card:hover { border-color: rgba(219, 173, 112, 0.37); background: rgba(34, 36, 39, 0.92); transform: translateY(-3px); }

@keyframes card-in { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.poster-button { display: block; width: 100%; border: 0px; padding: 0px; background: transparent; text-align: left; cursor: pointer; position: relative; }

.poster-art {
  --poster-tone: #84918d; height: 173px; overflow: hidden; isolation: isolate; position: relative; background: radial-gradient(ellipse at 58% 40%, var(--poster-tone) 0, transparent 26%), linear-gradient(138deg, var(--poster-tone), #252328 77%, #121416);
  @supports (color: color-mix(in lab, red, red)) {
  background: radial-gradient(ellipse at 58% 40%, color-mix(in srgb, var(--poster-tone), #e6c7a0 27%) 0, transparent 26%), linear-gradient(138deg, color-mix(in srgb, var(--poster-tone), #161719 46%), #252328 77%, #121416);
}
  transition: filter 0.25s;
}

.poster-art::before { content: ""; position: absolute; z-index: 2; inset: 0px; opacity: 0.24; background: repeating-linear-gradient(0deg, transparent 0px, transparent 3px, rgba(255, 255, 255, 0.08) 4px, transparent 5px); mix-blend-mode: soft-light; }

.poster-art::after { content: ""; position: absolute; inset: 0px; z-index: 3; background: linear-gradient(0deg, rgba(8, 9, 10, 0.65), transparent 46%, rgba(9, 10, 11, 0.08)); }

.poster-shape { position: absolute; }

.poster-shape-one {
  width: 100px; height: 152px; left: 42%; bottom: -21px; background: linear-gradient(100deg, #25282b, var(--poster-tone), #252629);
  @supports (color: color-mix(in lab, red, red)) {
  background: linear-gradient(100deg, #25282b, color-mix(in srgb,var(--poster-tone), #1c1e20 30%), #252629);
}
  clip-path: polygon(38% 0px, 67% 4%, 76% 26%, 100% 100%, 0px 100%, 24% 29%); filter: drop-shadow(rgba(0, 0, 0, 0.533) 0px 4px 7px); z-index: 1;
}

.poster-shape-two {
  width: 58px; height: 86px; left: 47%; bottom: 76px; border-radius: 45% 45% 40% 40%; background: linear-gradient(115deg,#262628, var(--poster-tone));
  @supports (color: color-mix(in lab, red, red)) {
  background: linear-gradient(115deg,#262628, color-mix(in srgb,var(--poster-tone),#242426 43%));
}
  z-index: 1;
}

.poster-shape-three { inset: 0px; z-index: 0; background: radial-gradient(at 50% 100%, rgba(228, 185, 127, 0.24), transparent 46%); }

.poster-caption { position: absolute; z-index: 4; left: 14px; bottom: 12px; color: rgba(242, 235, 222, 0.9); font: 500 15px/1.08 var(--app-font-serif); letter-spacing: -0.02em; text-shadow: rgba(0, 0, 0, 0.6) 0px 1px 5px; max-width: 78%; }

.poster-compact { height: 100%; min-height: 130px; }

.poster-compact .poster-caption { font-size: 10px; left: 7px; bottom: 7px; }

.poster-compact .poster-shape-one { transform: scale(0.72); transform-origin: center bottom; }

.poster-compact .poster-shape-two { transform: scale(0.7); transform-origin: center bottom; }

.poster-moon { background: radial-gradient(at 50% 15%, rgb(180, 168, 135) 0%, transparent 19%), linear-gradient(160deg, rgb(66, 85, 101), rgb(34, 47, 57) 68%, rgb(22, 27, 31)); }

.poster-moon .poster-shape-one { left: 42%; width: 115px; background: linear-gradient(90deg, rgb(24, 35, 41), rgb(135, 149, 160) 48%, rgb(32, 41, 46)); }

.poster-mood { background: radial-gradient(at 17% 53%, rgb(178, 91, 69), transparent 24%), linear-gradient(110deg, rgb(70, 31, 30), rgb(168, 90, 72) 48%, rgb(49, 29, 32)); }

.poster-mood .poster-shape-one { left: 36%; width: 102px; background: linear-gradient(90deg, rgb(53, 36, 36), rgb(176, 107, 81) 50%, rgb(48, 35, 36)); }

.poster-mood .poster-shape-two { left: 42%; background: rgb(48, 35, 38); }

.poster-budapest { background: radial-gradient(at 50% 30%, rgb(236, 195, 158), transparent 26%), linear-gradient(130deg, rgb(152, 83, 98), rgb(210, 140, 142) 46%, rgb(97, 75, 87)); }

.poster-budapest .poster-shape-one { left: 36%; bottom: -23px; width: 130px; height: 136px; background: linear-gradient(90deg, rgb(154, 81, 90), rgb(217, 151, 154), rgb(132, 72, 81)); clip-path: polygon(5% 100%, 12% 18%, 28% 18%, 28% 0px, 72% 0px, 72% 18%, 88% 18%, 95% 100%); }

.poster-arrival { background: radial-gradient(at 50% 56%, rgb(212, 208, 189) 0%, transparent 20%), linear-gradient(175deg, rgb(41, 56, 57), rgb(101, 118, 109) 48%, rgb(29, 41, 40)); }

.poster-arrival .poster-shape-one { width: 125px; height: 68px; left: 34%; bottom: 43px; border-radius: 50%; background: linear-gradient(rgb(26, 34, 34), rgb(89, 100, 91) 50%, rgb(34, 42, 41)); clip-path: ellipse(50% 46% at 50% 50%); }

.poster-arrival .poster-shape-two { display: none; }

.poster-sunrise { background: radial-gradient(at 75% 23%, rgb(244, 207, 135) 0%, transparent 26%), linear-gradient(160deg, rgb(170, 112, 80), rgb(214, 162, 108) 52%, rgb(69, 68, 61)); }

.poster-sunrise .poster-shape-one { left: 31%; width: 78px; background: linear-gradient(90deg, rgb(59, 56, 50), rgb(174, 137, 94), rgb(60, 55, 49)); }

.poster-parasite { background: linear-gradient(160deg, rgb(132, 144, 128), rgb(176, 170, 142) 48%, rgb(40, 49, 45)); }

.poster-parasite .poster-shape-one { left: 34%; height: 124px; bottom: 0px; background: linear-gradient(90deg, rgb(45, 48, 44), rgb(123, 133, 118), rgb(53, 57, 51)); clip-path: polygon(0px 30%, 100% 30%, 100% 100%, 0px 100%); }

.poster-parasite .poster-shape-two { width: 150px; height: 44px; left: 21%; bottom: 64px; border-radius: 0px; background: linear-gradient(rgb(209, 201, 172), rgb(61, 66, 59)); clip-path: polygon(8% 0px, 92% 0px, 100% 100%, 0px 100%); }

.poster-spirited { background: radial-gradient(at 63% 35%, rgb(214, 183, 128) 0%, transparent 22%), linear-gradient(160deg, rgb(66, 106, 121), rgb(99, 134, 152) 48%, rgb(39, 60, 73)); }

.poster-spirited .poster-shape-one { left: 39%; background: linear-gradient(90deg, rgb(58, 81, 79), rgb(180, 126, 89), rgb(53, 74, 71)); }

.poster-eternal { background: radial-gradient(at 38% 20%, rgb(190, 200, 160) 0%, transparent 27%), linear-gradient(160deg, rgb(102, 135, 116), rgb(177, 174, 123) 50%, rgb(61, 73, 64)); }

.poster-eternal .poster-shape-one { left: 28%; width: 105px; background: linear-gradient(90deg, rgb(48, 60, 56), rgb(135, 144, 119), rgb(60, 69, 60)); transform: rotate(-11deg); }

.poster-portrait { background: radial-gradient(at 70% 23%, rgb(212, 160, 108) 0%, transparent 20%), linear-gradient(145deg, rgb(119, 81, 68), rgb(189, 128, 91) 48%, rgb(49, 43, 42)); }

.poster-portrait .poster-shape-one { left: 42%; background: linear-gradient(90deg, rgb(52, 45, 43), rgb(167, 97, 72), rgb(51, 41, 42)); }

.poster-open { position: absolute; z-index: 5; right: 11px; top: 11px; display: grid; place-items: center; width: 27px; height: 27px; border-radius: 50%; color: rgb(240, 223, 198); background: rgba(17, 18, 19, 0.53); opacity: 0; transform: translateY(3px); transition: opacity 0.18s, transform 0.18s; }

.poster-button:hover .poster-open, .poster-button:focus-visible .poster-open { opacity: 1; transform: translateY(0px); }

.film-info { padding: 15px 15px 14px; }

.film-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }

.film-title-row h3 { overflow: hidden; margin: 0px; text-overflow: ellipsis; white-space: nowrap; color: rgb(227, 223, 214); font: 500 16px/1.2 var(--app-font-serif); letter-spacing: -0.025em; }

.film-year { flex: 0 0 auto; color: rgb(119, 123, 122); font: 9px var(--app-font-mono); }

